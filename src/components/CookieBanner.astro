---
import Icon from './Icon.astro';
---

<div 
  id="cookie-banner" 
  class="fixed bottom-20 sm:bottom-6 left-4 sm:left-6 z-50 max-w-sm sm:max-w-md bg-white rounded-2xl p-5 shadow-2xl border border-gray-200/90 text-[#1A1A1A] transition-all duration-300 transform translate-y-full opacity-0 pointer-events-none"
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
>
  <div class="flex items-start gap-3 mb-3">
    <div class="p-2 rounded-xl bg-amber-50 text-amber-600 border border-amber-200/80 shrink-0">
      <Icon name="cookie" class="w-5 h-5" />
    </div>
    <div>
      <h4 class="text-sm font-heading font-black text-[#0B2739]">Gestionamos tu privacidad</h4>
      <p class="text-xs text-gray-600 mt-1 leading-relaxed">
        Utilizamos cookies técnicas necesarias para el funcionamiento del sitio web y, con tu consentimiento, cookies analíticas para mejorar tu experiencia. Consulta nuestra <a href="/politica-de-cookies" class="text-[#00A9E0] underline font-semibold hover:text-[#0B2739]">Política de Cookies</a>.
      </p>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <button 
      id="cookie-accept" 
      type="button" 
      class="flex-1 bg-[#0B2739] hover:bg-[#00A9E0] text-white font-heading font-extrabold text-xs py-2.5 px-4 rounded-xl shadow-xs transition-colors"
    >
      Aceptar todas
    </button>
    <button 
      id="cookie-reject" 
      type="button" 
      class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-heading font-bold text-xs py-2.5 px-4 rounded-xl transition-colors"
    >
      Solo técnicas
    </button>
  </div>
</div>

<script>
  function initCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const rejectBtn = document.getElementById('cookie-reject');

    if (!banner || !acceptBtn || !rejectBtn) return;

    const consent = localStorage.getItem('iris_cookie_consent');
    if (!consent) {
      setTimeout(() => {
        banner.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
      }, 1000);
    }

    function hideBanner(value: string) {
      localStorage.setItem('iris_cookie_consent', value);
      banner?.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
    }

    acceptBtn.addEventListener('click', () => hideBanner('all'));
    rejectBtn.addEventListener('click', () => hideBanner('essential'));
  }

  initCookieBanner();
  document.addEventListener('astro:page-load', initCookieBanner);
</script>
