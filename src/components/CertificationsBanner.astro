---
import Icon from './Icon.astro';

const certifications = [
  {
    icon: 'shield' as const,
    title: 'Homologación Grado 2',
    subtitle: 'Normativa Europea UNE-EN 50131',
    desc: 'Certificación oficial requerida por ley para conexión a Policía y respuesta armada.',
    tag: 'UNE-EN 50131'
  },
  {
    icon: 'police' as const,
    title: 'Conexión Policía 24h',
    subtitle: 'Orden INT/316/2011',
    desc: 'Canal directo y prioritario con Policía Nacional y Guardia Civil en caso de intrusión.',
    tag: 'Aviso Inmediato'
  },
  {
    icon: 'control-panel' as const,
    title: 'CRA Oficial Prosegur',
    subtitle: 'Inscrita en el Registro DGP',
    desc: 'La Central Receptora de Alarmas líder de España vigilando tu inmueble 365 días al año.',
    tag: 'DGP Homologada'
  },
  {
    icon: 'lock' as const,
    title: 'Anti-Inhibición Activa',
    subtitle: 'Doble Vía de Transmisión',
    desc: 'Transmisión cifrada redundante (4G + IP). Si cortan la luz o la señal, salta la alerta.',
    tag: 'Máxima Seguridad'
  }
];
---

<section class="bg-[#0B2739] text-white py-10 sm:py-12 border-y border-white/10 relative overflow-hidden">
  <!-- Subtle decorative ambient -->
  <div class="absolute inset-0 bg-[radial-gradient(#00A9E0_1px,transparent_1px)] [background-size:24px_24px] opacity-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header strip -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-white/10">
      <div>
        <span class="text-[11px] font-heading font-extrabold uppercase tracking-widest text-[#FFD100] bg-[#FFD100]/10 px-3 py-1 rounded-full">
          Seguridad Regulada y Homologada
        </span>
        <h3 class="text-xl sm:text-2xl font-heading font-black text-white mt-2">
          Certificaciones técnicas y garantías operativas oficiales
        </h3>
      </div>
      <div class="text-xs text-gray-300 max-w-md">
        Instalaciones avaladas por el <strong class="text-white">Ministerio del Interior</strong> y gestionadas por personal técnico certificado.
      </div>
    </div>

    <!-- 4 Badges Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {certifications.map((item) => (
        <div class="bg-white/5 hover:bg-white/10 transition-colors p-5 rounded-2xl border border-white/10 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-10 h-10 rounded-xl bg-[#00A9E0]/20 text-[#00A9E0] flex items-center justify-center group-hover:scale-105 transition-transform">
                <Icon name={item.icon} class="w-5 h-5 text-[#00A9E0]" />
              </div>
              <span class="text-[10px] font-heading font-bold text-[#FFD100] bg-[#FFD100]/15 px-2 py-0.5 rounded-md uppercase tracking-wider">
                {item.tag}
              </span>
            </div>

            <h4 class="font-heading font-black text-white text-base leading-snug">
              {item.title}
            </h4>
            <p class="text-xs text-[#00A9E0] font-semibold mt-0.5 mb-2">
              {item.subtitle}
            </p>
            <p class="text-xs text-gray-300 leading-relaxed font-normal">
              {item.desc}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-white/10 flex items-center gap-1 text-[11px] font-bold text-emerald-400">
            <Icon name="check" class="w-3.5 h-3.5 text-emerald-400" />
            <span>Verificado por normativa</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
