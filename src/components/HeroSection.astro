---
import Icon from './Icon.astro';
---

<section id="soluciones" class="relative overflow-hidden bg-gradient-to-b from-white via-[#F8F9FA] to-white pt-8 pb-16 lg:py-20">
  <!-- Subtle Background Accents -->
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#00A9E0]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -left-24 w-96 h-96 bg-[#FFD100]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- SEGMENTED CONTROLLER (HOGAR / NEGOCIO) -->
    <div class="max-w-md mx-auto mb-8 sm:mb-12">
      <div class="bg-gray-200/80 p-1.5 rounded-2xl flex items-center justify-between shadow-inner border border-gray-300/60">
        <button
          id="tab-hogar-btn"
          type="button"
          class="tab-toggle-btn flex-1 flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl font-heading font-extrabold text-sm sm:text-base transition-all duration-300 bg-[#0B2739] text-white shadow-md active:scale-95"
          data-target="hogar"
        >
          <Icon name="home" class="w-5 h-5 text-current" />
          <span>Hogar</span>
          <span class="text-[11px] font-normal opacity-80 hidden sm:inline">(Familias)</span>
        </button>

        <button
          id="tab-negocio-btn"
          type="button"
          class="tab-toggle-btn flex-1 flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl font-heading font-extrabold text-sm sm:text-base transition-all duration-300 text-gray-700 hover:text-[#0B2739] active:scale-95"
          data-target="negocio"
        >
          <Icon name="building" class="w-5 h-5 text-current" />
          <span>Negocio</span>
          <span class="text-[11px] font-normal opacity-80 hidden sm:inline">(Empresas)</span>
        </button>
      </div>
    </div>

    <!-- MAIN CONTENT CONTAINER -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- LEFT COLUMN: DYNAMIC COPY -->
      <div class="lg:col-span-7 flex flex-col justify-center text-left">
        
        <!-- =================== STATE 1: HOGAR =================== -->
        <div id="content-hogar" class="tab-pane transition-opacity duration-300">
          <div class="inline-flex items-center gap-2 bg-[#00A9E0]/10 border border-[#00A9E0]/30 text-[#0B2739] px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase mb-4">
            <span class="w-2 h-2 rounded-full bg-[#00A9E0]"></span>
            Protege lo que más te importa
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-[#0B2739] tracking-tight leading-[1.15] mb-4">
            La tranquilidad de tu hogar no tiene precio. <span class="text-[#00A9E0]">Tu seguridad, sí tiene una solución.</span>
          </h1>

          <p class="text-base sm:text-lg text-gray-700 leading-relaxed mb-6 font-normal">
            Disuade y evita robos u ocupaciones con el sistema más avanzado. Soy <strong class="text-[#0B2739] font-bold">Iris Benítez</strong>, tu asesora experta Movistar Prosegur, y te ofrezco un estudio de seguridad gratuito adaptado a tu vivienda.
          </p>

          <!-- CTAs Hogar -->
          <div class="flex flex-col sm:flex-row gap-3.5 mb-8">
            <a
              href="https://wa.me/34639268526?text=Hola%20Iris,%20estoy%20interesado%20en%20un%20estudio%20de%20seguridad%20gratuito%20para%20mi%20Hogar."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-[#FFD100] hover:bg-[#ffe033] active:scale-98 text-[#0B2739] font-heading font-black text-base sm:text-lg px-7 py-4 rounded-2xl shadow-lg shadow-amber-500/20 hover:shadow-xl transition-all border border-amber-300"
            >
              <Icon name="phone" class="w-5 h-5 text-[#0B2739]" />
              <span>Solicitar Estudio Gratuito</span>
              <span class="text-xs bg-[#0B2739] text-white px-2 py-0.5 rounded-md font-bold uppercase tracking-wider">Hogar</span>
            </a>

            <a
              href="https://wa.me/34639268526?text=Hola%20Iris,%20estoy%20interesado%20en%20informaci%C3%B3n%20sobre%20la%20alarma%20de%20Hogar."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#20bd5a] text-white font-heading font-bold text-base px-6 py-4 rounded-2xl shadow-md hover:shadow-lg transition-all"
            >
              <Icon name="whatsapp" class="w-5 h-5 text-white" />
              <span>Hablar por WhatsApp</span>
            </a>
          </div>

          <!-- Feature Pills Hogar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-gray-200">
            <div class="flex items-center gap-2 text-xs font-semibold text-gray-700">
              <span class="p-1 rounded-lg bg-[#00A9E0]/10 text-[#00A9E0]">
                <Icon name="shield" class="w-4 h-4" />
              </span>
              <span>Protección 24/7</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold text-gray-700">
              <span class="p-1 rounded-lg bg-[#00A9E0]/10 text-[#00A9E0]">
                <Icon name="lock" class="w-4 h-4" />
              </span>
              <span>Antiocupación</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold text-gray-700">
              <span class="p-1 rounded-lg bg-[#00A9E0]/10 text-[#00A9E0]">
                <Icon name="cctv" class="w-4 h-4" />
              </span>
              <span>Verificación Real</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold text-gray-700">
              <span class="p-1 rounded-lg bg-[#00A9E0]/10 text-[#00A9E0]">
                <Icon name="smartphone" class="w-4 h-4" />
              </span>
              <span>Control App Total</span>
            </div>
          </div>
        </div>

        <!-- =================== STATE 2: NEGOCIO =================== -->
        <div id="content-negocio" class="tab-pane hidden transition-opacity duration-300">
          <div class="inline-flex items-center gap-2 bg-[#FFD100]/20 border border-[#FFD100]/60 text-[#0B2739] px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase mb-4">
            <span class="w-2 h-2 rounded-full bg-[#FFD100]"></span>
            Soluciones de seguridad corporativa
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-[#0B2739] tracking-tight leading-[1.15] mb-4">
            Tu negocio siempre protegido. <span class="text-[#00A9E0]">Sin sorpresas, sin subidas.</span>
          </h1>

          <p class="text-base sm:text-lg text-gray-700 leading-relaxed mb-6 font-normal">
            Concéntrate en hacer crecer tu negocio mientras nosotros vigilamos. <strong class="text-[#0B2739] font-bold">Precio fijo garantizado</strong>, conexión directa a Policía y control de accesos total desde tu móvil.
          </p>

          <!-- CTAs Negocio -->
          <div class="flex flex-col sm:flex-row gap-3.5 mb-8">
            <a
              href="https://wa.me/34639268526?text=Hola%20Iris,%20estoy%20interesado%20en%20un%20presupuesto%20de%20alarma%20para%20mi%20Negocio."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-[#FFD100] hover:bg-[#ffe033] active:scale-98 text-[#0B2739] font-heading font-black text-base sm:text-lg px-7 py-4 rounded-2xl shadow-lg shadow-amber-500/20 hover:shadow-xl transition-all border border-amber-300"
            >
              <Icon name="phone" class="w-5 h-5 text-[#0B2739]" />
              <span>Solicitar Presupuesto</span>
              <span class="text-xs bg-[#0B2739] text-white px-2 py-0.5 rounded-md font-bold uppercase tracking-wider">Negocio</span>
            </a>

            <a
              href="https://wa.me/34639268526?text=Hola%20Iris,%20necesito%20proteger%20mi%20comercio%20con%20el%20Superpack%20Negocio."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#20bd5a] text-white font-heading font-bold text-base px-6 py-4 rounded-2xl shadow-md hover:shadow-lg transition-all"
            >
              <Icon name="whatsapp" class="w-5 h-5 text-white" />
              <span>Hablar por WhatsApp</span>
            </a>
          </div>

          <!-- Feature Pills Negocio -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-gray-200">
            <div class="flex items-center gap-2 text-xs font-semibold text-gray-700">
              <span class="p-1 rounded-lg bg-[#00A9E0]/10 text-[#00A9E0]">
                <Icon name="euro" class="w-4 h-4" />
              </span>
              <span>Precio Fijo</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold text-gray-700">
              <span class="p-1 rounded-lg bg-[#00A9E0]/10 text-[#00A9E0]">
                <Icon name="police" class="w-4 h-4" />
              </span>
              <span>Aviso Policía</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold text-gray-700">
              <span class="p-1 rounded-lg bg-[#00A9E0]/10 text-[#00A9E0]">
                <Icon name="key" class="w-4 h-4" />
              </span>
              <span>Custodia Llaves</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold text-gray-700">
              <span class="p-1 rounded-lg bg-[#00A9E0]/10 text-[#00A9E0]">
                <Icon name="cctv" class="w-4 h-4" />
              </span>
              <span>Cámaras Directo</span>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: VISUAL CARD WITH HARDWARE & TRUST BADGE -->
      <div class="lg:col-span-5">
        <div class="relative bg-white rounded-3xl p-5 sm:p-7 shadow-xl border border-gray-200/80">
          
          <!-- Top Floating Guarantee Pill -->
          <div class="absolute -top-3.5 left-6 bg-[#0B2739] text-white text-xs font-heading font-extrabold px-4 py-1.5 rounded-full shadow-md flex items-center gap-1.5 tracking-wide">
            <Icon name="star" class="w-3.5 h-3.5 text-[#FFD100]" />
            <span id="kit-badge-text">EQUIPO HOGAR INTELIGENTE</span>
          </div>

          <!-- Hardware Image Display -->
          <div class="relative overflow-hidden rounded-2xl bg-[#F8F9FA] p-3 pt-6 flex items-center justify-center min-h-[260px]">
            <img 
              id="img-kit-hogar"
              src="/images/kit-hogar.webp" 
              alt="Kit de Alarma SuperSeguridad Movistar Prosegur Hogar"
              class="w-full h-auto object-contain transition-opacity duration-300"
              width="935"
              height="265"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <img 
              id="img-kit-negocio"
              src="/images/kit-negocio.webp" 
              alt="Kit de Alarma SuperSeguridad Movistar Prosegur Negocio"
              class="w-full h-auto object-contain transition-opacity duration-300 hidden"
              width="925"
              height="310"
              loading="lazy"
            />

            <!-- Floating Badges over Image -->
            <div class="absolute top-3 right-3 bg-[#FFD100] text-[#0B2739] text-[11px] font-extrabold px-3 py-1 rounded-lg shadow-sm flex items-center gap-1.5">
              <Icon name="gift" class="w-3.5 h-3.5 text-[#0B2739]" />
              <span>Cámara 360º de regalo</span>
            </div>
            
            <div class="absolute bottom-3 left-3 bg-[#0B2739]/90 text-white text-[11px] font-bold px-3 py-1 rounded-lg shadow-sm backdrop-blur-xs flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Aviso a Policía 24/7</span>
            </div>
          </div>

          <!-- Quick Advisor Confidence Strip -->
          <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img 
                src="/images/iris-portrait.webp" 
                alt="Iris Benítez Asesora Especializada"
                class="w-12 h-12 rounded-full object-cover border-2 border-[#00A9E0] shadow-sm"
                width="48"
                height="48"
              />
              <div>
                <p class="text-xs font-extrabold text-[#0B2739] leading-tight">Iris Benítez</p>
                <p class="text-[11px] text-gray-500 font-medium">Asesora Homologada de Zona</p>
              </div>
            </div>
            <a 
              href="tel:+34639268526"
              class="inline-flex items-center gap-1.5 text-xs font-extrabold text-[#0B2739] bg-gray-100 hover:bg-[#FFD100] px-3.5 py-2 rounded-xl transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-[#00A9E0]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
              <span>Llamar ahora</span>
            </a>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function setupTabs() {
    const btnHogar = document.getElementById('tab-hogar-btn');
    const btnNegocio = document.getElementById('tab-negocio-btn');
    const contentHogar = document.getElementById('content-hogar');
    const contentNegocio = document.getElementById('content-negocio');
    const imgHogar = document.getElementById('img-kit-hogar');
    const imgNegocio = document.getElementById('img-kit-negocio');
    const badgeText = document.getElementById('kit-badge-text');

    if (!btnHogar || !btnNegocio || !contentHogar || !contentNegocio || !imgHogar || !imgNegocio || !badgeText) return;

    function activateHogar() {
      // Buttons styling
      btnHogar.className = "tab-toggle-btn flex-1 flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl font-heading font-extrabold text-sm sm:text-base transition-all duration-300 bg-[#0B2739] text-white shadow-md active:scale-95";
      btnNegocio.className = "tab-toggle-btn flex-1 flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl font-heading font-extrabold text-sm sm:text-base transition-all duration-300 text-gray-700 hover:text-[#0B2739] active:scale-95";

      // Content visibility
      contentHogar.classList.remove('hidden');
      contentNegocio.classList.add('hidden');

      // Image visibility
      imgHogar.classList.remove('hidden');
      imgNegocio.classList.add('hidden');

      badgeText.textContent = "EQUIPO HOGAR INTELIGENTE";
    }

    function activateNegocio() {
      // Buttons styling
      btnNegocio.className = "tab-toggle-btn flex-1 flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl font-heading font-extrabold text-sm sm:text-base transition-all duration-300 bg-[#0B2739] text-white shadow-md active:scale-95";
      btnHogar.className = "tab-toggle-btn flex-1 flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl font-heading font-extrabold text-sm sm:text-base transition-all duration-300 text-gray-700 hover:text-[#0B2739] active:scale-95";

      // Content visibility
      contentHogar.classList.add('hidden');
      contentNegocio.classList.remove('hidden');

      // Image visibility
      imgHogar.classList.add('hidden');
      imgNegocio.classList.remove('hidden');

      badgeText.textContent = "SUPERPACK NEGOCIO PROFESIONAL";
    }

    btnHogar.addEventListener('click', activateHogar);
    btnNegocio.addEventListener('click', activateNegocio);
  }

  // Run on load
  setupTabs();
  document.addEventListener('astro:page-load', setupTabs);
</script>
