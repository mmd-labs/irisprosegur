---
---

<section id="asesora" class="py-16 sm:py-24 bg-white relative overflow-hidden">
  <!-- Decorative backdrops -->
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-[#00A9E0]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-[#0B2739] via-[#0d3148] to-[#0B2739] rounded-3xl p-6 sm:p-12 lg:p-16 text-white shadow-2xl relative overflow-hidden border border-white/10">
      
      <!-- Background Graphic Accents -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#00A9E0]/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute top-10 right-10 opacity-10 hidden md:block">
        <svg class="w-64 h-64 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
        </svg>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center relative z-10">
        
        <!-- Left: Image Column -->
        <div class="lg:col-span-5 flex flex-col items-center">
          <div class="relative group">
            <!-- Glow effect around portrait -->
            <div class="absolute -inset-1.5 bg-gradient-to-r from-[#FFD100] to-[#00A9E0] rounded-3xl blur opacity-60 group-hover:opacity-100 transition duration-500"></div>
            
            <div class="relative bg-[#0B2739] p-2 rounded-3xl overflow-hidden border-2 border-white/20 shadow-2xl">
              <img 
                src="/images/iris-portrait.webp" 
                alt="Iris Benítez - Asesora Especializada Movistar Prosegur Alarmas" 
                class="w-64 sm:w-72 md:w-80 h-auto object-cover rounded-2xl"
                width="320"
                height="360"
                loading="lazy"
              />
              
              <!-- Floating Badge -->
              <div class="absolute bottom-4 left-4 right-4 bg-[#0B2739]/95 backdrop-blur-md p-3 rounded-xl border border-white/15 text-center shadow-lg">
                <p class="text-[11px] uppercase tracking-widest text-[#FFD100] font-extrabold">Atención Directa y Personal</p>
                <p class="text-sm font-heading font-black text-white">Sin Esperas de Centralita</p>
              </div>
            </div>
          </div>

          <div class="mt-4 text-center">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-3.5 py-1 rounded-full">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Disponible ahora para asesorarte
            </span>
          </div>
        </div>

        <!-- Right: Story & Direct CTAs -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 bg-white/10 text-[#FFD100] px-3.5 py-1.5 rounded-full text-xs font-heading font-extrabold uppercase tracking-wider mb-4 border border-white/10">
            <span>🤝</span>
            <span>Seguridad, Conectividad y Comunicación</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight leading-tight mb-2 text-white">
            Tu hogar o negocio más seguro.
          </h2>

          <h3 class="text-xl sm:text-2xl font-heading font-bold text-[#00A9E0] mb-5">
            Hola, soy Iris Benítez.
          </h3>

          <div class="space-y-4 text-gray-200 text-base sm:text-lg leading-relaxed font-normal mb-8">
            <p>
              A diferencia de llamar a un <strong class="text-white font-semibold">"call center" automatizado</strong> donde pasas de un operador a otro, yo seré tu <strong class="text-white font-semibold">punto de contacto directo</strong> antes, durante y después de la instalación.
            </p>
            <p>
              Mi trabajo es analizar tu espacio (ya sea tu casa, chalet o tu local comercial), identificar los puntos vulnerables y diseñarte un <strong class="text-[#FFD100] font-bold">plan de seguridad a medida</strong> con precio cerrado y sin sorpresas.
            </p>
            <p class="text-white font-semibold italic text-base">
              "Hablemos de la seguridad de tu entorno, rápido, de tú a tú y sin compromiso."
            </p>
          </div>

          <!-- Signature & Designation -->
          <div class="mb-8 pb-6 border-b border-white/15 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <p class="text-lg font-heading font-black text-white">Iris Benítez</p>
              <p class="text-sm text-[#00A9E0] font-medium">Asesora Homologada de Confianza Movistar Prosegur Alarmas</p>
            </div>
            <div class="text-left sm:text-right">
              <span class="text-xs text-gray-400">Teléfono directo:</span>
              <p class="text-xl font-heading font-black text-[#FFD100]">639 26 85 26</p>
            </div>
          </div>

          <!-- Dual Conversion Buttons -->
          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href="https://wa.me/34639268526?text=Hola%20Iris,%20he%20visto%20tu%20web%20y%20me%20gustar%C3%ADa%20que%20me%20asesores%20para%20proteger%20mi%20inmueble."
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 inline-flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20bd5a] text-white font-heading font-extrabold text-base px-6 py-4 rounded-2xl shadow-lg hover:shadow-xl active:scale-95 transition-all"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
              <span>Hablar por WhatsApp</span>
            </a>

            <a 
              href="tel:+34639268526"
              class="flex-1 inline-flex items-center justify-center gap-3 bg-[#FFD100] hover:bg-[#ffe033] text-[#0B2739] font-heading font-black text-base px-6 py-4 rounded-2xl shadow-lg hover:shadow-xl active:scale-95 transition-all"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
              <span>Llamar al 639 26 85 26</span>
            </a>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
