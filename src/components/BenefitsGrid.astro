---
const benefits = [
  {
    icon: `<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="11" r="3"/><path d="M12 14v4"/></svg>`,
    title: "Vigilante de Intervención",
    badge: "Custodia 24m",
    desc: "Si salta la alarma, enviamos a un vigilante de seguridad de Prosegur inmediatamente a tu inmueble. Incluye servicio de custodia de llaves durante 24 meses.",
    color: "bg-blue-50 text-[#00A9E0] border-blue-200"
  },
  {
    icon: `<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5v6"/><path d="M9 8h6"/></svg>`,
    title: "Sistema ContiGo (SOS)",
    badge: "Hasta 6 usuarios",
    desc: "Seguridad y protección también fuera de casa o de tu negocio. Botón SOS en el móvil y acompañamiento seguro ante cualquier situación de peligro.",
    color: "bg-amber-50 text-amber-600 border-amber-200"
  },
  {
    icon: `<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/><path d="m9 9 6 6"/><path d="m15 9-6 6"/></svg>`,
    title: "Garantía Antiocupación",
    badge: "Protección Total",
    desc: "Actuación inmediata y prueba fehaciente ante Policía. Te asesoramos y protegemos legal y técnicamente ante intentos de ocupación indebida.",
    color: "bg-emerald-50 text-emerald-600 border-emerald-200"
  },
  {
    icon: `<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>`,
    title: "Doble Garantía Integral",
    badge: "Robo y Daños",
    desc: "Cobertura económica frente a robo, daños por agua, incendio o fenómenos meteorológicos. Tu patrimonio respaldado por las dos mayores compañías.",
    color: "bg-indigo-50 text-indigo-600 border-indigo-200"
  },
  {
    icon: `<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>`,
    title: "Control Total (App)",
    badge: "Conecta y Desconecta",
    desc: "Arma o desarma la alarma, consulta registros de accesos de empleados o familiares y recibe alertas al instante estés donde estés.",
    color: "bg-cyan-50 text-cyan-600 border-cyan-200"
  },
  {
    icon: `<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>`,
    title: "Videovigilancia Real",
    badge: "Cámaras HD",
    desc: "Verificación de imágenes en tiempo real y transmisión ultrarrápida a la Central Receptora de Alarmas. Nadie entra sin que quede registrado.",
    color: "bg-sky-50 text-sky-600 border-sky-200"
  }
];
---

<section id="beneficios" class="py-16 sm:py-20 bg-[#F8F9FA] border-t border-b border-gray-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="inline-block text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#00A9E0] bg-[#00A9E0]/10 px-3.5 py-1.5 rounded-full mb-3">
        Ventajas Exclusivas
      </span>
      <h2 class="text-3xl sm:text-4xl font-heading font-black text-[#0B2739] tracking-tight mb-4">
        Seguridad integral diseñada para proteger lo que de verdad importa.
      </h2>
      <p class="text-base sm:text-lg text-gray-600">
        Cada sistema incluye servicios operativos que van mucho más allá de un simple pitido: intervención presencial, aviso policial y doble garantía.
      </p>
    </div>

    <!-- Grid of Cards (2 cols mobile, 3 cols desktop) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-14">
      {benefits.map((item) => (
        <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-xs hover:shadow-lg transition-all duration-300 border border-gray-200/70 flex flex-col justify-between group hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class={`w-13 h-13 rounded-xl flex items-center justify-center border ${item.color} transition-transform group-hover:scale-105 p-3`} set:html={item.icon} />
              <span class="text-[11px] font-heading font-extrabold uppercase tracking-wider bg-gray-100 text-[#0B2739] px-2.5 py-1 rounded-md">
                {item.badge}
              </span>
            </div>

            <h3 class="text-lg font-heading font-black text-[#0B2739] mb-2 group-hover:text-[#00A9E0] transition-colors">
              {item.title}
            </h3>

            <p class="text-sm text-gray-600 leading-relaxed font-normal">
              {item.desc}
            </p>
          </div>

          <div class="mt-5 pt-4 border-t border-gray-100 flex items-center text-xs font-bold text-[#00A9E0]">
            <span>Incluido en tu cuota</span>
            <span class="ml-auto text-gray-400">✓</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Pillars Banner (from flyer) -->
    <div class="bg-[#0B2739] rounded-2xl p-6 sm:p-8 text-white shadow-xl">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center divide-y md:divide-y-0 md:divide-x divide-white/10">
        <div class="pt-3 md:pt-0">
          <p class="text-2xl mb-1">🛡️</p>
          <p class="font-heading font-extrabold text-sm sm:text-base text-[#FFD100]">MÁS SEGURIDAD</p>
          <p class="text-xs text-gray-300 mt-1">Disuasión policial activa</p>
        </div>
        <div class="pt-3 md:pt-0">
          <p class="text-2xl mb-1">🕊️</p>
          <p class="font-heading font-extrabold text-sm sm:text-base text-[#00A9E0]">MÁS TRANQUILIDAD</p>
          <p class="text-xs text-gray-300 mt-1">Respuesta inmediata</p>
        </div>
        <div class="pt-3 md:pt-0">
          <p class="text-2xl mb-1">❤️</p>
          <p class="font-heading font-extrabold text-sm sm:text-base text-[#FFD100]">MÁS PROTECCIÓN</p>
          <p class="text-xs text-gray-300 mt-1">Doble garantía 24 meses</p>
        </div>
        <div class="pt-3 md:pt-0">
          <p class="text-2xl mb-1">🤝</p>
          <p class="font-heading font-extrabold text-sm sm:text-base text-white">SIEMPRE CONTIGO</p>
          <p class="text-xs text-gray-300 mt-1">Asesora Iris Benítez a tu lado</p>
        </div>
      </div>
    </div>

  </div>
</section>
