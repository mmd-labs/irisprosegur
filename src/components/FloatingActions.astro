---
import Icon from './Icon.astro';
---

<!-- FLOATING WHATSAPP BUTTON (ALWAYS ACCESSIBLE BOTTOM-RIGHT) -->
<aside class="fixed bottom-20 sm:bottom-6 right-4 sm:right-6 z-50 flex items-center group">
  <!-- Tooltip on hover / initial prompt -->
  <div class="hidden md:flex items-center mr-3 bg-white text-[#0B2739] text-xs font-heading font-extrabold px-3.5 py-2 rounded-2xl shadow-xl border border-gray-200 opacity-95 group-hover:opacity-100 transition-all pointer-events-none select-none">
    <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-ping"></span>
    ¿Dudas con tu alarma? ¡Escríbeme!
  </div>

  <a
    href="https://wa.me/34639268526?text=Hola%20Iris,%20estoy%20interesado%20en%20recibir%20informaci%C3%B3n%20y%20asesoramiento%20sobre%20una%20alarma."
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar con Iris Benítez por WhatsApp"
    class="flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 bg-[#25D366] hover:bg-[#20bd5a] active:scale-90 text-white rounded-full shadow-2xl hover:shadow-emerald-500/40 transition-all duration-300 relative border-2 border-white"
  >
    <span class="absolute -top-1 -right-1 flex h-4 w-4">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-400 border border-white"></span>
    </span>

    <Icon name="whatsapp" class="w-7 h-7 sm:w-8 sm:h-8 text-white" />
  </a>
</aside>

<!-- STICKY MOBILE CALL BAR (ONLY VISIBLE ON PHONES) -->
<aside class="fixed bottom-0 left-0 right-0 z-40 bg-[#0B2739]/95 backdrop-blur-md p-2.5 sm:hidden border-t border-white/15 shadow-2xl flex items-center justify-between gap-3">
  <div class="pl-2">
    <p class="text-[10px] text-[#00A9E0] font-extrabold uppercase tracking-wider">Asesora Homologada</p>
    <p class="text-xs font-bold text-white leading-tight">Iris Benítez</p>
  </div>

  <a
    href="tel:+34639268526"
    class="flex-1 flex items-center justify-center gap-2 bg-[#FFD100] hover:bg-[#ffe033] active:scale-95 text-[#0B2739] font-heading font-black text-sm py-2.5 px-4 rounded-xl shadow-md border border-amber-300"
    aria-label="Llamar al 639 26 85 26"
  >
    <Icon name="phone" class="w-4 h-4 text-[#0B2739]" />
    <span>LLAMAR: 639 26 85 26</span>
  </a>
</aside>
