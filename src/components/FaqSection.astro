---
import Icon from './Icon.astro';

const faqs = [
  {
    q: "¿La instalación requiere hacer obras en mi casa o local?",
    a: "No. Todos nuestros dispositivos son completamente inalámbricos y de última tecnología. La instalación es limpia, estética y profesional, sin rozas ni cables por las paredes, y se realiza habitualmente en un plazo aproximado de 2 a 3 horas."
  },
  {
    q: "¿Qué ocurre si tengo mascotas en casa?",
    a: "Nuestros detectores con cámara incorporan tecnología pet-immune diseñada para discriminar animales de compañía de hasta 25-30 kg. Tu mascota podrá moverse con total libertad por la casa mientras la alarma está armada sin disparar falsas alarmas."
  },
  {
    q: "¿Cuánto cuesta el estudio de seguridad?",
    a: "Es 100% gratuito y sin ningún tipo de compromiso. Como tu asesora directa, analizo contigo las características de tu vivienda o negocio (puntos de acceso, balcones, persianas) y te facilito una propuesta con precio cerrado, sin sorpresas ni letra pequeña."
  },
  {
    q: "¿Qué sucede si cortan la luz o intentan inhibir la señal?",
    a: "El panel central cuenta con batería de respaldo autónoma que sigue operando aunque haya un apagón o corte intencionado. Además, dispone de doble vía de comunicación y tecnología anti-inhibición: ante cualquier intento de bloqueo, la Central Receptora de Alarmas recibe la alerta al instante y activa el protocolo policial."
  },
  {
    q: "¿Por qué contratar con Iris Benítez en vez de llamar a una centralita general?",
    a: "Contratar directamente con una agente homologada te garantiza una atención de tú a tú, sin pasar por filtros ni robots. Recibes un estudio adaptado a tus necesidades reales (sin sobrecostes en dispositivos innecesarios), promociones directas y un canal de WhatsApp personal para cualquier gestión."
  }
];
---

<section id="faq" class="py-16 sm:py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-12 sm:mb-16">
      <span class="inline-block text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#00A9E0] bg-[#00A9E0]/10 px-3.5 py-1.5 rounded-full mb-3">
        Preguntas Frecuentes
      </span>
      <h2 class="text-3xl sm:text-4xl font-heading font-black text-[#0B2739] tracking-tight mb-4">
        Resolvemos todas tus dudas antes de dar el paso.
      </h2>
      <p class="text-base sm:text-lg text-gray-600">
        Sin tecnicismos ni letra pequeña. Todo lo que necesitas saber de forma clara y transparente.
      </p>
    </div>

    <!-- Accordion Items -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-[#F8F9FA] rounded-2xl border border-gray-200/80 p-5 sm:p-6 transition-all duration-200 [&_summary::-webkit-details-marker]:hidden open:bg-white open:shadow-md open:border-[#00A9E0]/40">
          <summary class="flex items-center justify-between cursor-pointer font-heading font-bold text-base sm:text-lg text-[#0B2739] select-none gap-4">
            <span class="flex items-center gap-3">
              <span class="text-[#00A9E0] font-black text-sm sm:text-base">0{index + 1}.</span>
              <span>{faq.q}</span>
            </span>
            <span class="shrink-0 w-8 h-8 rounded-full bg-white group-open:bg-[#00A9E0] group-open:text-white border border-gray-200 group-open:border-[#00A9E0] flex items-center justify-center text-gray-500 transition-transform duration-300 group-open:rotate-180 text-sm font-bold">
              ↓
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-gray-200/60 text-sm sm:text-base text-gray-700 leading-relaxed font-normal">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

    <!-- CTA Below FAQ -->
    <div class="mt-12 p-6 sm:p-8 bg-[#0B2739] text-white rounded-3xl text-center shadow-lg border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="text-left">
        <h3 class="text-lg sm:text-xl font-heading font-black text-[#FFD100]">¿Tienes una duda específica sobre tu caso?</h3>
        <p class="text-xs sm:text-sm text-gray-300 mt-1">Pregúntaselo directamente a Iris Benítez por WhatsApp en 2 minutos.</p>
      </div>
      <a 
        href="https://wa.me/34639268526?text=Hola%20Iris,%20tengo%20una%20duda%20sobre%20la%20instalaci%C3%B3n%20de%20la%20alarma."
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20bd5a] text-white font-heading font-bold text-sm px-6 py-3.5 rounded-full shadow-md transition-all active:scale-95"
      >
        <Icon name="whatsapp" class="w-5 h-5 text-white" />
        <span>Preguntar por WhatsApp</span>
      </a>
    </div>

  </div>
</section>
