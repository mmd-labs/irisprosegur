---
import Icon from './Icon.astro';
---

<footer class="bg-[#0B2739] text-white pt-14 pb-24 lg:pb-14 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Info -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/images/logo-movistar-prosegur.webp" 
            alt="Movistar Prosegur Alarmas" 
            class="h-10 w-auto object-contain brightness-110"
            width="270"
            height="75"
            loading="lazy"
          />
        </div>
        <p class="text-sm text-gray-300 leading-relaxed max-w-md">
          Portal informativo y comercial gestionado por <strong class="text-white">Iris Benítez</strong>, Agente Comercial Autorizado de Movistar Prosegur Alarmas. Asesoramiento personalizado en sistemas de seguridad y alarmas para hogares y negocios.
        </p>
        <div class="flex items-center gap-2 text-xs text-[#00A9E0] font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Atención directa en España: Lunes a Sábado 08:00 - 21:00</span>
        </div>
      </div>

      <!-- Contact Direct -->
      <div class="space-y-3">
        <h4 class="text-xs font-heading font-extrabold uppercase tracking-widest text-[#FFD100]">
          Contacto Directo
        </h4>
        <ul class="space-y-2.5 text-sm text-gray-300">
          <li class="flex items-center gap-2.5">
            <span class="text-[#00A9E0]">
              <Icon name="phone" class="w-4 h-4" />
            </span>
            <a href="tel:+34639268526" class="hover:text-[#FFD100] transition-colors font-bold text-white">
              639 26 85 26
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-[#25D366]">
              <Icon name="whatsapp" class="w-4 h-4" />
            </span>
            <a 
              href="https://wa.me/34639268526?text=Hola%20Iris,%20estoy%20interesado%20en%20informaci%C3%B3n%20sobre%20las%20alarmas." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-[#25D366] transition-colors"
            >
              WhatsApp Comercial
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-gray-400">
              <Icon name="user" class="w-4 h-4" />
            </span>
            <span>Iris Benítez - Asesora Especializada</span>
          </li>
        </ul>
      </div>

      <!-- Legal Links -->
      <div class="space-y-3">
        <h4 class="text-xs font-heading font-extrabold uppercase tracking-widest text-[#FFD100]">
          Información Legal
        </h4>
        <ul class="space-y-2 text-sm text-gray-300">
          <li>
            <a href="/aviso-legal" class="hover:text-[#00A9E0] transition-colors">
              Aviso Legal y Condiciones
            </a>
          </li>
          <li>
            <a href="/politica-de-privacidad" class="hover:text-[#00A9E0] transition-colors">
              Política de Privacidad (RGPD)
            </a>
          </li>
          <li>
            <a href="/politica-de-cookies" class="hover:text-[#00A9E0] transition-colors">
              Política de Cookies
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Disclaimer -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <p>
        © {new Date().getFullYear()} Iris Benítez. Todos los derechos reservados.
      </p>
      <p class="max-w-xl text-center md:text-right text-[11px] leading-relaxed text-gray-500">
        Aclaración sobre marcas: Los nombres comerciales y logotipos de Movistar, Prosegur y Movistar Prosegur Alarmas pertenecen a sus respectivos titulares y se usan exclusivamente con fines comerciales y de intermediación autorizada.
      </p>
    </div>
  </div>
</footer>
