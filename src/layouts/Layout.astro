---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { faqs } from '../data/faqs';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = "Alarma Movistar Prosegur | Iris Benítez Asesora Especializada",
  description = "Protege tu hogar o negocio con la Alarma Movistar Prosegur. Estudio de seguridad gratuito, instalación rápida y doble garantía. Contacta con Iris Benítez al 639 26 85 26.",
  canonical = "https://irisprosegur.vercel.app",
  image = "/images/kit-hogar.webp"
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Movistar Prosegur Alarmas - Iris Benítez",
  "description": "Asesora especializada en alarmas Movistar Prosegur para hogares y negocios. Estudio de seguridad personalizado gratuito.",
  "telephone": "+34639268526",
  "url": canonical,
  "image": "https://irisprosegur.vercel.app/images/iris-portrait.webp",
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "ES"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday"
    ],
    "opens": "08:00",
    "closes": "21:00"
  },
  "areaServed": "ES",
  "sameAs": [
    "https://wa.me/34639268526"
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0B2739" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Movistar Prosegur Alarmas - Iris Benítez" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- WPO Preloads: Fonts & LCP Hero Image -->
    <link rel="preload" href="/fonts/montserrat-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="image" href="/images/kit-hogar.webp" type="image/webp" fetchpriority="high" />

    <!-- Schema.org Structured Data: LocalBusiness & FAQPage Rich Snippets -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </head>
  <body class="bg-[#F8F9FA] text-[#1A1A1A] antialiased selection:bg-[#FFD100] selection:text-[#0B2739] min-h-screen flex flex-col">
    <Header />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <FloatingActions />
    <CookieBanner />
  </body>
</html>
